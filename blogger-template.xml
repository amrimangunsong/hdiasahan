<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsversion='3' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/gastats' xmlns:data='http://www.google.com/schema/ga'>
<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <title><data:blog.title/></title>
  
  <!-- Asset CSS dari GitHub via JSDelivr -->
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/gh/amrimangunsong/hdiasahan@main/dist/assets/index.css'/>
  
  <b:skin><![CDATA[
    body { margin: 0; padding: 0; }
    #navbar-iframe { display: none !important; }
  ]]></b:skin>
</head>
<body>
  <!-- Root React App -->
  <div id='root'></div>

  <!-- Section wajib Blogger (disembunyikan) -->
  <div style='display:none'>
    <b:section id='main' showaddelement='no'>
      <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' visible='false'>
        <b:includable id='main'></b:includable>
      </b:widget>
    </b:section>
  </div>

  <!-- Asset JS dari GitHub via JSDelivr -->
  <script type='module' src='https://cdn.jsdelivr.net/gh/amrimangunsong/hdiasahan@main/dist/assets/index.js'></script>
